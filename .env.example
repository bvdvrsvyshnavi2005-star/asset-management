# Used by docker-compose.yml. Copy to .env (never commit .env).
# generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The backend runs with NODE_ENV=production in Docker and refuses secrets < 32 chars or placeholders.
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=1d
CLIENT_ORIGIN=http://localhost:8080
